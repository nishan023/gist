# GitHub login that owns the gists. Required for live data.
GITHUB_USERNAME=
# Server-only token with permission to read your gists. Never use NEXT_PUBLIC_.
GITHUB_TOKEN=
# Set true to deliberately publish ALL your secret gists on this public site.
PUBLISH_SECRET_GISTS=false
# Optional comma-separated gist IDs to exclude from the public site.
EXCLUDED_GIST_IDS=
SITE_URL=https://gist.dhakalnishan.com.np
